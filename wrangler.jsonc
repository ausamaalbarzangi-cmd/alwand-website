{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alwand-website",
  "compatibility_date": "2026-11-09",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "alwand",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
